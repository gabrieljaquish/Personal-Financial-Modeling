# =============================================================================
# PRIVACY RULE: no financial information is ever committed to this repository.
# Balances, holdings, transactions, plan parameters, and any credentials or
# tokens for financial institutions live ONLY in a local encrypted store on the
# user's machine. Everything below exists to make an accidental commit hard.
# =============================================================================

# --- Local user data (never commit) ------------------------------------------
/data/
/local/
/imports/
exports/
/backups/
*.local.json
*.local.toml
*.local.yaml
*.local.yml
*.export.csv
*.export.json
# Root-anchored on purpose: a loose plan or parameter file dropped at the top
# level is ignored, while `params/**` and `fixtures/**` (public tables and
# synthetic fixtures the build needs) are not silently hidden at depth.
/params.json
/params.toml
/params.yaml
/plan.json
/plan.toml

# Encrypted plan containers, their backups and in-flight saves (SECURITY.md §13.1).
# `cargo xtask check-magic` deliberately does NOT honour these entries: it walks
# the working tree itself, so a container sitting here is still reported.
*.pfplan
*.pfplan.bak*
*.pfplan.tmp*
*.pfplan.prev*

# Encrypted stores and databases (still never commit: ciphertext is not a backup strategy)
*.age
*.enc
*.gpg
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
*.sqlcipher

# Financial-institution / personal-finance export formats
*.qif
*.qfx
*.ofx
*.qdf
*.qel
*.mny
/*.tax20*
*.txf

# --- Secrets -------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
# Apple signing material (SECURITY.md §13.1)
*.p8
*.p12
*.cer
*.mobileprovision
*.pfx
*.keystore
secrets/
credentials/
**/*secret*
**/*credential*
# ...but never source or documentation: an ignored module vanishes from the
# build and from every hygiene gate at once, with no error.
!docs/**/*secret*
!docs/**/*credential*
!crates/**/*secret*
!crates/**/*credential*
!xtask/**/*secret*
!xtask/**/*credential*
!web/src/**/*secret*
!web/src/**/*credential*
# ...nor a workflow, a synthetic fixture or a public parameter table. Each of
# these patterns must also match a DIRECTORY named *secret* / *credential* (as
# `**/*secret*` does), or git prunes the directory before it ever sees the file
# negation. Re-run the check-ignore AND `git add -A` test before narrowing them.
!.github/**/*secret*
!.github/**/*credential*
!/fixtures/**/*secret*
!/fixtures/**/*credential*
!/params/**/*secret*
!/params/**/*credential*

# Local TLS material for the localhost server
/certs/
*.crt
*.csr

# --- Build / tooling -------------------------------------------------------------
# Rust
/target/
**/*.rs.bk
# Python / test-time oracles (SECURITY.md §13.1, §11.1: never committed)
oracles/**/.venv/
.uv-cache/
.policyengine-cache/
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
# Node / web front end
node_modules/
# Anchored: an unanchored `dist/` or `build/` would silently hide a source
# directory of that name at any depth (a crate's build-script module directory,
# a `dist` asset folder under web/src).
/dist/
/build/
/web/dist/
/web/build/
.next/
.svelte-kit/
.vite/
coverage/

# --- OS / editor -------------------------------------------------------------------
.DS_Store
Thumbs.db
*.swp
*.bak
*.tmp
.idea/
.vscode/
!.vscode/extensions.json

# --- Synthetic fixtures -------------------------------------------------------------
# The importer fixtures under fixtures/ (ARCHITECTURE.md §3, TESTING.md §3) are
# synthetic .qif/.ofx/.qdf/.csv files; the institution-export ignores above must not
# hide them. `data-hygiene` requires each to carry the synthetic marker or a
# citation. Secrets, keys and plan containers stay ignored here too.
!/fixtures/**/*.qif
!/fixtures/**/*.qfx
!/fixtures/**/*.ofx
!/fixtures/**/*.txf
!/fixtures/**/*.qdf
!/fixtures/**/*.mny
!/fixtures/**/*.export.csv

# --- Claude Code local state ---------------------------------------------------------
.claude/settings.local.json
