            "type": "array"
          },
          "verified": {
            "description": "Whether every table and series has been verified by a human.",
            "type": "boolean"
          }
        },
        "required": [
          "name",
          "contentId",
          "verified",
          "tables",
          "indexSeries"
        ],
        "type": "object"
      },
      "VintageReport": {
        "additionalProperties": false,
        "description": "One parameter vintage (`ARCHITECTURE.md` §6, ADR-010).",
        "properties": {
          "archive": {
            "$ref": "#/components/schemas/ArchiveCheck",
            "description": "See [`ArchiveCheck`], summed over the vintage."
          },
          "contentId": {
            "description": "`<name>@<sha256>` as `pfp-params` computes it; claims nothing by itself.",
            "type": "string"
          },
          "documents": {
            "description": "Every table and series.",
            "items": {
              "$ref": "#/components/schemas/TableReport"
            },
            "type": "array"
          },
          "indexSeriesCount": {
            "description": "Archived index series the tables read.",
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          },
          "locked": {
            "description": "Whether `params/VINTAGES.lock` covers this vintage.",
            "type": "boolean"
          },
          "lockedId": {
            "description": "The id a result may be pinned to: the content id, only when locked.",
            "type": [
              "string",
              "null"
            ]
          },
          "name": {
            "description": "The vintage name.",
            "type": "string"
          },
          "openItemCount": {
            "description": "Open hand-verification questions across the vintage.",
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          },
          "tableCount": {
            "description": "Parameter tables.",
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          },
          "verification": {
            "description": "The verification values present, worst first.",
            "items": {
              "$ref": "#/components/schemas/CountByKey"
            },
            "type": "array"
          },
          "verified": {
            "description": "Whether every table and series carries a human sign-off.",
            "type": "boolean"
          }
        },
        "required": [
          "name",
          "contentId",
          "locked",
          "verified",
          "verification",
          "tableCount",
          "indexSeriesCount",
          "openItemCount",
          "documents",
          "archive"
        ],
        "type": "object"
      },
      "VintageSummaryDto": {
        "description": "A parameter vintage's identity, without its tables.",
        "properties": {
          "contentId": {
            "description": "`name@sha256:…` computed from the content; claims nothing by itself.",
            "type": "string"
          },
          "lockedId": {
            "description": "The locked id, present only when `params/VINTAGES.lock` records this content.",
            "type": [
              "string",
              "null"
            ]
          },
          "name": {
            "description": "The vintage's name.",
            "type": "string"
          },
          "verified": {
            "description": "Whether every table and series has been verified by a human.",
            "type": "boolean"
          }
        },
        "required": [
          "name",
          "contentId",
          "verified"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "sessionCookie": {
        "description": "Set by the bootstrap; HttpOnly. Useless without the proof.",
        "in": "cookie",
        "name": "__Host-pfp",
        "type": "apiKey"
      },
      "sessionProof": {
        "description": "Returned by the bootstrap; kept in sessionStorage. Useless without the cookie.",
        "in": "header",
        "name": "X-PFP-Proof",
        "type": "apiKey"
      }
    }
  },
  "info": {
    "description": "Served only on https://127.0.0.1:<port> to the application's own front end. Every operation is POST and requires exact Host, Origin and Sec-Fetch-Site headers. All money is integer cents.",
    "license": {
      "identifier": "Apache-2.0",
      "name": "Apache-2.0"
    },
    "title": "Personal Financial Modeling local API",
    "version": "v1"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/assumptions/list": {
      "post": {
        "operationId": "list",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AssumptionsResponse"
                }
              }
            },
            "description": "The registry."
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "`session_required`."
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "`session_cookie_displaced`."
          }
        },
        "security": [
          {
            "sessionCookie": [],
            "sessionProof": []
          }
        ],
        "summary": "Lists every vintage compiled into this build, with every table in it.",
        "tags": [
          "assumptions"
        ]
      }
    },
    "/api/v1/session/bootstrap": {
      "post": {
        "operationId": "bootstrap",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BootstrapRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BootstrapResponse"
                }
              }
            },
            "description": "Session established. Sets the `__Host-pfp` cookie (`Secure; HttpOnly; SameSite=Strict; Path=/`)."
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "`launch_token_invalid`: wrong, expired or already used."
          }
        },
        "summary": "Exchanges the launch token for the session pair.",
        "tags": [
          "session"
        ]
      }
    },
    "/api/v1/session/relaunch": {
      "post": {
        "operationId": "relaunch",
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Accepted"
                }
              }
            },
            "description": "A fresh launch URL was handed to the opener."
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "`session_required`."
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "`relaunch_throttled`: inside the minimum interval, try again later. `relaunch_exhausted`: the per-session cap is used up and waiting does not help."
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "`open_unavailable`: this build has no opener."
          }
        },
        "security": [
          {
            "sessionProof": []
          }
        ],
        "summary": "Asks the running application to re-open itself in the browser: the recovery\nfrom a displaced cookie. Needs the proof only. The fresh launch token goes to\nthe opener inside the process and is never in this response.",
        "tags": [
          "session"
        ]
      }
    },
    "/api/v1/session/status": {
      "post": {
        "operationId": "status",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionStatus"
                }
              }
            },
            "description": "The session is live."
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "`session_required`."
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "`session_cookie_displaced`."
          }
        },
        "security": [
          {
            "sessionCookie": [],
            "sessionProof": []
          }
        ],
        "summary": "Health, versions and trust mode.",
        "tags": [
          "session"
        ]
      }
    },
    "/api/v1/tax/rate-schedule": {
      "post": {
        "operationId": "rate_schedule",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RateScheduleRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RateScheduleResponse"
                }
              }
            },
            "description": "The worksheet."
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "`invalid_json`."
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "`session_required`."
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "`session_cookie_displaced`."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "`request_invalid` or `schedule_input_invalid`."
          }
        },
        "security": [
          {
            "sessionCookie": [],
            "sessionProof": []
          }
        ],
        "summary": "Computes the ordinary-income rate schedule and returns the whole worksheet.",
        "tags": [
          "tax"
        ]
      }
    },
    "/api/v1/tax/rate-schedule/export": {
      "post": {
        "description": "The worksheet is recomputed from the inputs; the client never posts lines\nback. CSV text cells carry spreadsheet formula-injection escaping and amounts\nare bare numbers; the JSON is the worksheet's values verbatim.",
        "operationId": "rate_schedule_export",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RateScheduleExportRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "string"
                }
              },
              "text/csv": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "description": "The worksheet as an attachment, in the requested format."
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "`invalid_json`."
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "`session_required`."
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "`session_cookie_displaced`."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "`request_invalid` or `schedule_input_invalid`."
          }
        },
        "security": [
          {
            "sessionCookie": [],
            "sessionProof": []
          }
        ],
        "summary": "Exports the rate-schedule worksheet as a CSV or JSON attachment.",
        "tags": [
          "tax"
        ]
      }
    },
    "/api/v1/validation/report": {
      "post": {
        "operationId": "report",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationReportResponse"
                }
              }
            },
            "description": "The report, or `state: not-generated` with no report (a debug build on a checkout where `cargo xtask validation-report` was not run; a release build always carries one)."
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "`session_required`."
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "`session_cookie_displaced`."
          }
        },
        "security": [
          {
            "sessionCookie": [],
            "sessionProof": []
          }
        ],
        "summary": "The validation report compiled into this build, or the `not-generated` state.",
        "tags": [
          "validation"
        ]
      }
    }
  }
}
