---
source: crates/pfp-server/tests/openapi.rs
expression: openapi_json()
---
{
  "components": {
    "schemas": {
      "Accepted": {
        "description": "An accepted request with nothing to report.",
        "type": "object"
      },
      "ArchiveCheck": {
        "additionalProperties": false,
        "description": "How the archived copies a document's `[[source]]` blocks cite check out.",
        "properties": {
          "archivedCount": {
            "description": "Sources naming an archived copy under `params/provenance/`.",
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          },
          "checksumMatchCount": {
            "description": "Archived copies whose SHA-256 equals the recorded one.",
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          },
          "checksumMismatchCount": {
            "description": "Archived copies whose SHA-256 differs from the recorded one.",
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          },
          "missingCount": {
            "description": "Sources naming an archive path that does not exist.",
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          },
          "sourceCount": {
            "description": "`[[source]]` blocks.",
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "sourceCount",
          "archivedCount",
          "checksumMatchCount",
          "checksumMismatchCount",
          "missingCount"
        ],
        "type": "object"
      },
      "AssumptionDto": {
        "description": "One parameter table: an entry of the Assumptions Registry.",
        "properties": {
          "asOf": {
            "description": "The law as in effect on this date (`YYYY-MM-DD`).",
            "type": "string"
          },
          "components": {
            "description": "The named components of each value, low to high; empty for a single amount.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "id": {
            "description": "The table id.",
            "type": "string"
          },
          "openItems": {
            "description": "Questions a human still owes this table.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "period": {
            "description": "The period the amounts apply to (for example `year`).",
            "type": [
              "string",
              "null"
            ]
          },
          "projection": {
            "$ref": "#/components/schemas/ProjectionDto",
            "description": "See [`ProjectionDto`]."
          },
          "rates": {
            "additionalProperties": {
              "items": {
                "$ref": "#/components/schemas/RatioDto"
              },
              "type": "array"
            },
            "description": "The rate ladder in force in each published year; empty when the table has\nno rates.",
            "propertyNames": {
              "type": "string"
            },
            "type": "object"
          },
          "rounding": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/RoundingDto",
                "description": "See [`RoundingDto`]."
              }
            ]
          },
          "servedUnit": {
            "description": "The unit `values` and the projection's base values are **served** in.\nAlways `cents`: the engine holds every amount in integer cents.\n\nThis is not the table's declared `unit` (`ARCHITECTURE.md` §6, seam S1).\nThe declared `unit` and `breakdown` are not published yet: `ParamTable`\nparses and validates both but exposes neither. At M0 the loader accepts\nonly `USD` amounts, `ratio` rates and a `filingStatus` breakdown, so the\nkeys of `values` are `FilingStatus` wire forms. Both declarations must be\nserved from the table itself before the M2 override layer validates an\noverride against the declared unit (`ENGINE-SPEC.md` §15 check 10).",
            "type": "string"
          },
          "sources": {
            "description": "Primary sources.",
            "items": {
              "$ref": "#/components/schemas/SourceDto"
            },
            "type": "array"
          },
          "values": {
            "additionalProperties": {
              "additionalProperties": {
                "items": {
                  "$ref": "#/components/schemas/Cents"
                },
                "type": "array"
              },
              "propertyNames": {
                "type": "string"
              },
              "type": "object"
            },
            "description": "Published amounts: breakdown key → year → one amount per component.",
            "propertyNames": {
              "type": "string"
            },
            "type": "object"
          },
          "verification": {
            "$ref": "#/components/schemas/VerificationDto",
            "description": "See [`VerificationDto`]."
          },
          "vintageId": {
            "description": "The id of the vintage this table belongs to, `<name>@sha256:<content\nhash>`: the enclosing [`VintageDto::content_id`], repeated so one entry\ntaken alone still carries the pin a result records.",
            "type": "string"
          }
        },
        "required": [
          "id",
          "servedUnit",
          "components",
          "asOf",
          "verification",
          "vintageId",
          "projection",
          "sources",
          "values",
          "rates",
          "openItems"
        ],
        "type": "object"
      },
      "AssumptionsResponse": {
        "description": "The Assumptions Registry.",
        "properties": {
          "vintages": {
            "description": "Every vintage compiled into this build.",
            "items": {
              "$ref": "#/components/schemas/VintageDto"
            },
            "type": "array"
          }
        },
        "required": [
          "vintages"
        ],
        "type": "object"
      },
      "BootstrapRequest": {
        "additionalProperties": false,
        "description": "The launch token from the URL fragment.",
        "properties": {
          "token": {
            "description": "64 lower-case hex characters. Single use, 60 s.",
            "maxLength": 64,
            "minLength": 64,
            "type": "string"
          }
        },
        "required": [
          "token"
        ],
        "type": "object"
      },
      "BootstrapResponse": {
        "description": "The port-scoped half of the session; the other half is the `__Host-` cookie.",
        "properties": {
          "proof": {
            "description": "Goes into `sessionStorage[\"pfp.proof\"]` and then into `X-PFP-Proof`.",
            "type": "string"
          }
        },
        "required": [
          "proof"
        ],
        "type": "object"
      },
      "Cents": {
        "description": "An amount of money in integer cents.",
        "format": "int64",
        "type": "integer",
        "x-money": true
      },
      "CountByKey": {
        "additionalProperties": false,
        "description": "A count keyed by a name (a milestone, a module, a verification value, a crate).",
        "properties": {
          "count": {
            "description": "How many.",
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          },
          "name": {
            "description": "The name counted under (a milestone, a module, a verification value, a crate).",
            "type": "string"
          }
        },
        "required": [
          "name",
          "count"
        ],
        "type": "object"
      },
      "DerivationDto": {
        "description": "A key defined as an exact multiple of another key's rounded result.",
        "properties": {
          "from": {
            "description": "The key it derives from.",
            "type": "string"
          },
          "multiplier": {
            "$ref": "#/components/schemas/RatioDto",
            "description": "The multiplier."
          }
        },
        "required": [
          "from",
          "multiplier"
        ],
        "type": "object"
      },
      "ErrorBody": {
        "description": "`{\"code\", \"message\"}`: the body of every refusal and failure.",
        "properties": {
          "code": {
            "description": "Stable, machine-readable code.",
            "type": "string"
          },
          "message": {
            "description": "Fixed human-readable text. Never echoes a request value.",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "type": "object"
      },
      "ExportFormatDto": {
        "description": "The file format of an export.",
        "enum": [
          "csv",
          "json"
        ],
        "type": "string"
      },
      "FilingStatusDto": {
        "description": "Filing status, in the domain's wire form.",
        "enum": [
          "single",
          "mfj",
          "mfs",
          "hoh",
          "qss"
        ],
        "type": "string"
      },
      "FixtureFile": {
        "additionalProperties": false,
        "description": "One fixture document, as its envelope declares it (`TESTING.md` §2.2).",
        "properties": {
          "caseCount": {
            "description": "How many `expect.cases` or `expect.lines` the document carries.",
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          },
          "id": {
            "description": "The envelope's `id`.",
            "type": [
              "string",
              "null"
            ]
          },
          "milestone": {
            "description": "The milestone it must be green in.",
            "type": [
              "string",
              "null"
            ]
          },
          "module": {
            "description": "The engine crate it drives (`module`).",
            "type": [
              "string",
              "null"
            ]
          },
          "paramVintage": {
            "description": "The `paramVintage` pin, when one is recorded.",
            "type": [
              "string",
              "null"
            ]
          },
          "path": {
            "description": "Repository-relative path.",
            "type": "string"
          },
          "promotesTo": {
            "description": "The tier-1 id a pending fixture promotes to.",
            "type": [
              "string",
              "null"
            ]
          },
          "reviewKind": {
            "description": "`reviewedBy.kind` of a hand-worked-reviewed fixture.",
            "type": [
              "string",
              "null"
            ]
          },
          "synthetic": {
            "description": "The `synthetic` marker, when declared.",
            "type": [
              "boolean",
              "null"
            ]
          },
          "verification": {
            "description": "The `verification` value, or `unstated`.",
            "type": "string"
          }
        },
        "required": [
          "path",
          "verification",
          "caseCount"
        ],
        "type": "object"
      },
      "FixtureGroup": {
        "additionalProperties": false,
        "description": "A fixture count for one milestone and one verification value.",
        "properties": {
          "count": {
            "description": "How many fixtures carry both.",
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          },
          "milestone": {
            "description": "The fixture's declared `milestone`.",
            "type": "string"
          },
          "verification": {
            "description": "The fixture's declared `verification`.",
            "type": "string"
          }
        },
        "required": [
          "milestone",
          "verification",
          "count"
        ],
        "type": "object"
      },
      "FixtureReport": {
        "additionalProperties": false,
        "description": "The fixture corpus by tier, milestone and verification value.",
        "properties": {
          "invalid": {
            "description": "Files that could not be read as envelopes.",
            "items": {
              "$ref": "#/components/schemas/InvalidFixture"
            },
            "type": "array"
          },
          "otherDirectories": {
            "description": "Other `fixtures/` directories that exist (`personas`, `plans`, …) with their file counts.",
            "items": {
              "$ref": "#/components/schemas/CountByKey"
            },
            "type": "array"
          },
          "status": {
            "$ref": "#/components/schemas/SectionStatus",
            "description": "See [`SectionStatus`]."
          },
          "tiers": {
            "description": "The four directories, always all four.",
            "items": {
              "$ref": "#/components/schemas/TierReport"
            },
            "type": "array"
          }
        },
        "required": [
          "status",
          "tiers",
          "invalid",
          "otherDirectories"
        ],
        "type": "object"
      },
      "IndexSeriesDto": {
        "description": "Provenance of an archived index series a table projects with.",
        "properties": {
          "asOf": {
            "description": "Data as published on this date (`YYYY-MM-DD`).",
            "type": "string"
          },
          "id": {
            "description": "The series document's id.",
            "type": "string"
          },
          "indexSeries": {
            "description": "The name tables refer to it by.",
            "type": "string"
          },
          "openItems": {
            "description": "Questions a human still owes this series.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "seriesId": {
            "description": "The publisher's own series identifier.",
            "type": [
              "string",
              "null"
            ]
          },
          "sources": {
            "description": "Primary sources.",
            "items": {
              "$ref": "#/components/schemas/SourceDto"
            },
            "type": "array"
          },
          "verification": {
            "$ref": "#/components/schemas/VerificationDto",
            "description": "See [`VerificationDto`]."
          },
          "years": {
            "description": "The calendar years the series covers.",
            "items": {
              "format": "int32",
              "type": "integer"
            },
            "type": "array"
          }
        },
        "required": [
          "id",
          "indexSeries",
          "asOf",
          "verification",
          "years",
          "sources",
          "openItems"
        ],
        "type": "object"
      },
      "InvalidFixture": {
        "additionalProperties": false,
        "description": "A file under `fixtures/` that is not a readable envelope.",
        "properties": {
          "path": {
            "description": "Repository-relative path.",
            "type": "string"
          },
          "problem": {
            "description": "What is wrong with it (never its content).",
            "type": "string"
          }
        },
        "required": [
          "path",
          "problem"
        ],
        "type": "object"
      },
      "Invariant": {
        "additionalProperties": false,
        "description": "One row of the invariant inventory (`TESTING.md` §4).",
        "properties": {
          "crateName": {
            "description": "The crate that guards it.",
            "type": "string"
          },
          "id": {
            "description": "`I1`, `I4b`, …",
            "type": "string"
          },
          "milestone": {
            "description": "The milestone that introduces it.",
            "type": "string"
          },
          "name": {
            "description": "Its name.",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "crateName",
          "milestone"
        ],
        "type": "object"
      },
      "LineDto": {
        "description": "One computed value and everything needed to audit it. The worksheet is the\nordered list of these; the tree is followed through `inputs`.",
        "properties": {
          "id": {
            "description": "Stable id; the prefix names the worksheet.",
            "type": "string"
          },
          "inputs": {
            "description": "Ids of the lines this value was computed from, in formula order.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "label": {
            "description": "Human-readable name.",
            "type": "string"
          },
          "params": {
            "description": "The parameter cells this value read, in formula order.",
            "items": {
              "$ref": "#/components/schemas/ParamRefDto"
            },
            "type": "array"
          },
          "rounding": {
            "description": "The named rounding rule that produced the value, if one did.",
            "type": [
              "string",
              "null"
            ]
          },
          "value": {
            "$ref": "#/components/schemas/Cents",
            "description": "The value."
          }
        },
        "required": [
          "id",
          "label",
          "value"
        ],
        "type": "object"
      },
      "LockReport": {
        "additionalProperties": false,
        "description": "`params/VINTAGES.lock`.",
        "properties": {
          "entryCount": {
            "description": "Files it names.",
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          },
          "lockedVintages": {
            "description": "Vintage directories it covers.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "present": {
            "description": "Whether the file exists.",
            "type": "boolean"
          }
        },
        "required": [
          "present",
          "entryCount",
          "lockedVintages"
        ],
        "type": "object"
      },
      "OpenItem": {
        "additionalProperties": false,
        "description": "An open hand-verification question recorded in a parameter document.",
        "properties": {
          "document": {
            "description": "The table or series id.",
            "type": "string"
          },
          "item": {
            "description": "The question.",
            "type": "string"
          }
        },
        "required": [
          "document",
          "item"
        ],
        "type": "object"
      },
      "ParamRefDto": {
        "description": "A reference to one parameter cell.",
        "properties": {
          "breakdownKey": {
            "description": "The breakdown key read (for example a filing status).",
            "type": [
              "string",
              "null"
            ]
          },
          "element": {
            "description": "The component read (for example a bracket edge).",
            "type": [
              "string",
              "null"
            ]
          },
          "paramId": {
            "description": "The table id.",
            "type": "string"
          },
          "year": {
            "description": "The year read.",
            "format": "int32",
            "type": [
              "integer",
              "null"
            ]
          }
        },
        "required": [
          "paramId"
        ],
        "type": "object"
      },
      "ParameterReport": {
        "additionalProperties": false,
        "description": "Parameter vintages, the lock and the provenance archive.",
        "properties": {
          "lock": {
            "$ref": "#/components/schemas/LockReport",
            "description": "See [`LockReport`]."
          },
          "provenance": {
            "$ref": "#/components/schemas/ProvenanceReport",
            "description": "See [`ProvenanceReport`]."
          },
          "status": {
            "$ref": "#/components/schemas/SectionStatus",
            "description": "See [`SectionStatus`]."
          },
          "vintages": {
            "description": "Every vintage under `params/vintages/`.",
            "items": {
              "$ref": "#/components/schemas/VintageReport"
            },
            "type": "array"
          }
        },
        "required": [
          "status",
          "vintages",
          "lock",
          "provenance"
        ],
        "type": "object"
      },
      "PerformanceBudget": {
        "additionalProperties": false,
        "description": "One performance budget (`TESTING.md` §10).",
        "properties": {
          "budget": {
            "description": "The budget's name.",
            "type": "string"
          },
          "milestone": {
            "description": "The milestone it gates from.",
            "type": "string"
          },
          "threshold": {
            "description": "The threshold as the design states it.",
            "type": "string"
          }
        },
        "required": [
          "budget",
          "threshold",
          "milestone"
        ],
        "type": "object"
      },
      "PerformanceReport": {
        "additionalProperties": false,
        "description": "Performance budgets.",
        "properties": {
          "budgets": {
            "description": "The budgets the design states; none is measured until a bench exists.",
            "items": {
              "$ref": "#/components/schemas/PerformanceBudget"
            },
            "type": "array"
          },
          "status": {
            "$ref": "#/components/schemas/SectionStatus",
            "description": "See [`SectionStatus`]."
          }
        },
        "required": [
          "status",
          "budgets"
        ],
        "type": "object"
      },
      "Pins": {
        "additionalProperties": false,
        "description": "What a result would be pinned to (ADR-010), as far as anything exists.",
        "properties": {
          "applicationVersion": {
            "description": "The workspace version the report was generated for.",
            "type": "string"
          },
          "binaryDigest": {
            "description": "The binary digest; absent until the release pipeline exists.",
            "type": [
              "string",
              "null"
            ]
          },
          "engineVersion": {
            "description": "`engineVersion`; absent until the engine declares one.",
            "type": [
              "string",
              "null"
            ]
          },
          "licence": {
            "description": "The licence declared in the workspace manifest.",
            "type": "string"
          },
          "lockedParamVintageIds": {
            "description": "Ids of the vintages the lock covers.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "note": {
            "description": "Why the absent pins are absent.",
            "type": "string"
          },
          "paramVintageContentIds": {
            "description": "Content ids of every vintage, locked or not.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "schemaVersion": {
            "description": "The plan `schemaVersion`; absent until the plan schema exists.",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "applicationVersion",
          "licence",
          "paramVintageContentIds",
          "lockedParamVintageIds",
          "note"
        ],
        "type": "object"
      },
      "ProjectionDto": {
        "description": "How a year the table does not publish is projected.",
        "properties": {
          "baseValues": {
            "additionalProperties": {
              "items": {
                "$ref": "#/components/schemas/Cents"
              },
              "type": "array"
            },
            "description": "The statutory base amounts per breakdown key, one per component.",
            "propertyNames": {
              "type": "string"
            },
            "type": "object"
          },
          "baseYear": {
            "description": "The statutory base year, when it is one year for the whole table.",
            "format": "int32",
            "type": [
              "integer",
              "null"
            ]
          },
          "baseYearByComponent": {
            "additionalProperties": {
              "items": {
                "format": "int32",
                "type": "integer"
              },
              "type": "array"
            },
            "description": "The statutory base year per component, by the first tax year it applies to.",
            "propertyNames": {
              "type": "string"
            },
            "type": [
              "object",
              "null"
            ]
          },
          "derived": {
            "additionalProperties": {
              "$ref": "#/components/schemas/DerivationDto"
            },
            "description": "Keys defined as multiples of another key.",
            "propertyNames": {
              "type": "string"
            },
            "type": "object"
          },
          "firstAdjustedYear": {
            "description": "The first tax year whose amounts are adjusted.",
            "format": "int32",
            "type": [
              "integer",
              "null"
            ]
          },
          "index": {
            "description": "The index the law names.",
            "type": [
              "string",
              "null"
            ]
          },
          "indexSeries": {
            "description": "The archived series that index resolves to.",
            "type": [
              "string",
              "null"
            ]
          },
          "lagYears": {
            "description": "Which calendar year of the series a tax year reads, as an offset.",
            "format": "int32",
            "type": [
              "integer",
              "null"
            ]
          },
          "rule": {
            "description": "`index`, `wage`, `flat`, `zero` or `schedule`.",
            "type": "string"
          }
        },
        "required": [
          "rule",
          "baseValues",
          "derived"
        ],
        "type": "object"
      },
      "PropertyFile": {
        "additionalProperties": false,
        "description": "One source file holding `proptest!` properties.",
        "properties": {
          "caseCount": {
            "description": "The `cases:` budget the file's `ProptestConfig` states, when it states one.",
            "format": "int32",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "crate": {
            "description": "The crate.",
            "type": "string"
          },
          "path": {
            "description": "Repository-relative path.",
            "type": "string"
          },
          "propertyNames": {
            "description": "The property functions, in file order.",
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "crate",
          "path",
          "propertyNames"
        ],
        "type": "object"
      },
      "PropertyReport": {
        "additionalProperties": false,
        "description": "Property-based and metamorphic tests.",
        "properties": {
          "files": {
            "description": "Files holding `proptest!` blocks.",
            "items": {
              "$ref": "#/components/schemas/PropertyFile"
            },
            "type": "array"
          },
