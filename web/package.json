{
  "name": "pfp-web",
  "version": "0.0.0",
  "private": true,
  "description": "Front end for Personal Financial Modeling: static assets embedded in the pfp executable and served from the loopback origin.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=26.6.0 <27",
    "npm": ">=11.18.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && npm test && vite build && node scripts/write-stamp.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --import ./tests/support/register.mjs --test \"tests/*.test.mjs\"",
    "gen:api": "node scripts/gen-api-types.mjs",
    "licenses": "node scripts/check-licences.mjs"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "vite": "7.3.6"
  }
}
